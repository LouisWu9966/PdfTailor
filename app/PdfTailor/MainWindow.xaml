<Window x:Class="PdfTailor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PdfTailor.Controls"
        Icon="Assets/PdfTailor.ico"
        Title="PdfTailor" Width="1360" Height="880" MinWidth="980" MinHeight="620"
        Background="#0B111B" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="MergeFileTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="#263B53" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Order}" Foreground="#9FE9FF" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FullPath}" Foreground="#7F91AE" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PagesLabel}" Foreground="#C6D4EA" FontSize="12" TextAlignment="Right"/>
                    <TextBlock Text="{Binding SizeLabel}" Foreground="#8292AD" FontSize="11" TextAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== top bar ===== -->
        <Border Grid.Row="0" Background="#0F1724" BorderBrush="#1E2B40" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavToggle" Content="☰" Style="{StaticResource GhostButton}" Click="OnToggleNav" Padding="11,6" Margin="0,0,14,0"
                            ToolTip="隱藏功能欄 (Ctrl+M)"/>
                    <TextBlock Text="PdfTailor" FontSize="19" FontWeight="SemiBold" Foreground="#28D7FF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SubTitle" Text="掃描 PDF 文字編輯" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="10,4,22,0" VerticalAlignment="Center"/>
                    <StackPanel x:Name="EditToolbar" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Content="開啟 PDF" Style="{StaticResource GhostButton}" Click="OnOpen" Padding="14,8"/>
                    <Border Width="1" Background="#22304A" Margin="14,4"/>
                    <Button x:Name="PrevPage" Content="‹" Style="{StaticResource GhostButton}" Click="OnPrevPage" Padding="12,6" IsEnabled="False" ToolTip="上一頁 (PageUp)"/>
                    <TextBlock x:Name="PageLabel" Text="–" Margin="10,0" MinWidth="60" TextAlignment="Center" VerticalAlignment="Center" Foreground="#C6D4EA"/>
                    <Button x:Name="NextPage" Content="›" Style="{StaticResource GhostButton}" Click="OnNextPage" Padding="12,6" IsEnabled="False" ToolTip="下一頁 (PageDown)"/>
                    <ComboBox x:Name="ZoomBox" Width="96" Margin="14,0,0,0" SelectionChanged="OnZoomChanged" ToolTip="縮放">
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="100%" Tag="1.0"/>
                        <ComboBoxItem Content="125%" Tag="1.25" IsSelected="True"/>
                        <ComboBoxItem Content="150%" Tag="1.5"/>
                        <ComboBoxItem Content="200%" Tag="2.0"/>
                    </ComboBox>
                    <Button x:Name="ReOcrButton" Content="重新辨識此頁" Style="{StaticResource GhostButton}" Click="OnReOcr" Padding="14,8" Margin="14,0,0,0" IsEnabled="False"
                            ToolTip="以影像辨識（OCR）重新分析這一頁，即使它有文字層"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="EditRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ModifiedLabel" Text="" Foreground="#9FE9FF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="ExportButton" Content="預覽並輸出" Style="{StaticResource PrimaryButton}" Click="OnPreviewExport" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== content ===== -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- collapsible left navigation rail (☰ in the top bar, Ctrl+M) -->
          <Border x:Name="NavRail" Grid.Column="0" Width="196" ClipToBounds="True"
                  Background="#0D1420" BorderBrush="#1E2B40" BorderThickness="0,0,1,0">
              <StackPanel Width="195" Margin="10,16,10,0">
                  <TextBlock Text="功能" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="10,0,0,6"/>
                  <Button x:Name="NavEdit" Style="{StaticResource NavButton}" Content="✎   編輯 PDF" Click="OnNavEdit" Padding="14,11"/>
                  <Button x:Name="NavMerge" Style="{StaticResource NavButton}" Content="⊞   PDF 合併" Click="OnNavMerge" Padding="14,11"/>
                  <Button x:Name="NavWord" Style="{StaticResource NavButton}" Content="W   PDF 轉 Word" Click="OnNavWord" Padding="14,11"/>
              </StackPanel>
          </Border>

          <Grid x:Name="EditView" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- page -->
            <Grid Grid.Column="0" Background="#0A0F18">
                <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid x:Name="PageHost" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="OnOverlayEmptyClick"/>
                        <Canvas x:Name="BeamLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                </ScrollViewer>

                <!-- empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <c:ScanDemo HorizontalAlignment="Center"/>
                    <TextBlock Text="把掃描的 PDF 拖進來，或按「開啟 PDF」" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="辨識文字、保留字型與版面，只改你要改的字；圖片與圖表一律不動。完全離線。"
                               Foreground="{StaticResource MutedInkBrush}" FontSize="13" HorizontalAlignment="Center"/>
                    <Button Content="開啟 PDF" Style="{StaticResource PrimaryButton}" Click="OnOpen" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <!-- inspector -->
            <Border Grid.Column="1" Background="#0F1724" BorderBrush="#1E2B40" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16">
                        <TextBlock Text="文字區塊" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BlockInfo" Text="點選頁面上的文字框開始編輯。" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <StackPanel x:Name="Inspector" IsEnabled="False">
                            <TextBox x:Name="EditText" Style="{StaticResource FieldBox}" TextChanged="OnTextChanged" TextWrapping="NoWrap"/>
                            <TextBlock Text="原文" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,8,0,2"/>
                            <TextBlock x:Name="OriginalText" Foreground="#AEBCCD" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Text="符號" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,14,0,6"/>
                            <WrapPanel x:Name="SymbolPanel"/>

                            <TextBlock Text="字型" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,10,0,6"/>
                            <ComboBox x:Name="FamilyBox" SelectionChanged="OnFamilyChanged" IsTextSearchEnabled="True"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SizeBox" Style="{StaticResource FieldBox}" Width="70" KeyDown="OnSizeKey" LostFocus="OnSizeCommit" ToolTip="字級（pt）"/>
                                    <TextBlock Text="pt" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                                    <Button Content="−" Style="{StaticResource ChipButton}" Margin="0,0,4,0" Click="OnSizeDown"/>
                                    <Button Content="+" Style="{StaticResource ChipButton}" Margin="0,0,0,0" Click="OnSizeUp"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource StyleToggle}" Click="OnBoldClick" ToolTip="粗體 (Ctrl+B)">
                                        <TextBlock Text="B" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ItalicToggle" Style="{StaticResource StyleToggle}" Click="OnItalicClick" Margin="6,0,0,0" ToolTip="斜體 (Ctrl+I)">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="顏色" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,12,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <WrapPanel x:Name="ColorPanel"/>
                                <TextBox x:Name="ColorHex" Style="{StaticResource FieldBox}" Width="86" FontFamily="Consolas" KeyDown="OnColorHexKey" LostFocus="OnColorHexCommit"/>
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="對齊" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AlignBox" SelectionChanged="OnAlignChanged">
                                        <ComboBoxItem Content="靠左" Tag="left" IsSelected="True"/>
                                        <ComboBoxItem Content="置中" Tag="center"/>
                                        <ComboBoxItem Content="靠右" Tag="right"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="舊字背景" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="FillBox" SelectionChanged="OnFillChanged"
                                              ToolTip="自動：掃描頁用周圍紙張修補舊字；純色：用背景色塗滿；不覆蓋：只移除文字層">
                                        <ComboBoxItem Content="自動修補" Tag="auto" IsSelected="True"/>
                                        <ComboBoxItem Content="純色填滿" Tag="solid"/>
                                        <ComboBoxItem Content="不覆蓋" Tag="none"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="NotesBox" Background="#2A2212" BorderBrush="#5C4718" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="NotesText" Foreground="#F5D48A" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="還原此行" Style="{StaticResource GhostButton}" Click="OnRevert" Padding="14,8"/>
                                <Button Content="上一行" Style="{StaticResource GhostButton}" Click="OnPrevBlock" Padding="12,8" Margin="8,0,0,0" ToolTip="Shift+Tab"/>
                                <Button Content="下一行" Style="{StaticResource GhostButton}" Click="OnNextBlock" Padding="12,8" Margin="8,0,0,0" ToolTip="Tab"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#1E2B40" Margin="0,22,0,14"/>
                        <TextBlock Text="圖例" FontSize="12" Foreground="{StaticResource MutedInkBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="18" Height="12" BorderBrush="#5D7BA3" BorderThickness="1" CornerRadius="2"/>
                            <TextBlock Text=" 可編輯" FontSize="12" Foreground="#AEBCCD" Margin="4,0,14,0"/>
                            <Border Width="18" Height="12" BorderBrush="#F5B941" BorderThickness="1.5" CornerRadius="2"/>
                            <TextBlock Text=" 辨識信心低，請確認" FontSize="12" Foreground="#AEBCCD" Margin="4,0,14,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="18" Height="12" BorderBrush="#65E6AD" BorderThickness="1.5" CornerRadius="2"/>
                            <TextBlock Text=" 已修改" FontSize="12" Foreground="#AEBCCD" Margin="4,0,14,0"/>
                            <Border Width="18" Height="12" BorderBrush="#28D7FF" BorderThickness="2" CornerRadius="2"/>
                            <TextBlock Text=" 選取中" FontSize="12" Foreground="#AEBCCD" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
          </Grid>

          <!-- ===== PDF merge ===== -->
          <Grid x:Name="MergeView" Grid.Column="1" Background="#0A0F18" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="300"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Margin="28,24,24,24">
                  <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <StackPanel>
                      <TextBlock Text="PDF 合併" FontSize="26" FontWeight="SemiBold"/>
                      <TextBlock Text="依清單順序合併成一份 PDF；可直接拖曳項目調整順序，或選取後用右側按鈕上下移動。"
                                 Foreground="{StaticResource MutedInkBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border x:Name="MergeDropZone" Grid.Row="1" Height="76" Margin="0,18,0,14" AllowDrop="True"
                          Background="#111F2E" BorderBrush="#334C68" BorderThickness="1" CornerRadius="12">
                      <TextBlock Text="⇣  將 PDF 拖放到此處（可一次多份）" Foreground="#8DDFF1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Grid Grid.Row="2">
                      <ListView x:Name="MergeList" SelectionMode="Single" AllowDrop="True"
                                ItemTemplate="{StaticResource MergeFileTemplate}"
                                PreviewMouseLeftButtonDown="OnMergeListMouseDown" PreviewMouseMove="OnMergeListMouseMove"
                                DragOver="OnMergeListDragOver" Drop="OnMergeListDrop"/>
                      <TextBlock x:Name="MergeEmptyHint" Text="清單是空的。至少加入 2 份 PDF 才能合併。" Foreground="#5F7290"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
              </Grid>
              <Border Grid.Column="1" Background="#0F1724" BorderBrush="#1E2B40" BorderThickness="1,0,0,0">
                  <StackPanel Margin="18,24">
                      <TextBlock Text="排序與輸出" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock x:Name="MergeSummary" Text="尚未加入檔案" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,4,0,18"/>
                      <Button Content="＋  加入 PDF" Style="{StaticResource GhostButton}" Click="OnMergeAdd" Margin="0,0,0,8" ToolTip="Ctrl+O"/>
                      <Button Content="↑  上移" Style="{StaticResource GhostButton}" Tag="up" Click="OnMergeAction" Margin="0,0,0,8"/>
                      <Button Content="↓  下移" Style="{StaticResource GhostButton}" Tag="down" Click="OnMergeAction" Margin="0,0,0,8"/>
                      <Button Content="移除所選" Style="{StaticResource GhostButton}" Tag="remove" Click="OnMergeAction" Margin="0,0,0,8"/>
                      <Button Content="清空全部" Style="{StaticResource GhostButton}" Tag="clear" Click="OnMergeAction" Margin="0,0,0,22"/>
                      <Button x:Name="MergeButton" Content="合併並輸出 PDF  →" Style="{StaticResource PrimaryButton}" Click="OnMerge" IsEnabled="False"/>
                  </StackPanel>
              </Border>
          </Grid>

          <!-- ===== PDF to Word ===== -->
          <Grid x:Name="WordView" Grid.Column="1" Background="#0A0F18" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="340"/>
              </Grid.ColumnDefinitions>
              <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="28,24,24,24">
                      <TextBlock Text="PDF 轉 Word" FontSize="26" FontWeight="SemiBold"/>
                      <TextBlock Text="把選定頁面轉成可編輯的 Word 文件：逐行文字合併成段落，自動判斷標題與清單，表格轉成 Word 表格。全程在本機執行，不上傳檔案。"
                                 Foreground="{StaticResource MutedInkBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                      <Border Background="#111F2E" BorderBrush="#334C68" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,18,0,18">
                          <Grid>
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                  <TextBlock x:Name="WordFileName" Text="尚未開啟 PDF" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock x:Name="WordFileInfo" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0"/>
                              </StackPanel>
                              <Button Grid.Column="1" Content="開啟 PDF…" Style="{StaticResource GhostButton}" Click="OnWordOpen" VerticalAlignment="Center" ToolTip="Ctrl+O"/>
                          </Grid>
                      </Border>
                      <TextBlock Text="轉換規則" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Foreground="#AEBCCD" FontSize="12.5" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"
                                 Text="• 段落：同一段落折行的文字接成一段；中文不加空白，英文以空白連接。&#10;• 標題：依字級與粗體判斷，對應 Word 的標題 1–4。&#10;• 清單：項目符號與編號（1. 、（一）、a) …）保留原符號，並套用凸排縮排。&#10;• 表格：偵測有框線的表格（含合併儲存格、底色、框線）；沒有框線但欄位對齊的表格也會轉成表格。&#10;• 每個 PDF 頁面成為 Word 的一個區段，沿用原頁面大小與邊界。&#10;• 掃描頁會先做文字辨識，速度較慢。&#10;• 目前不轉出圖片與頁首頁尾。"/>
                  </StackPanel>
              </ScrollViewer>
              <Border Grid.Column="1" Background="#0F1724" BorderBrush="#1E2B40" BorderThickness="1,0,0,0">
                  <StackPanel Margin="18,24">
                      <TextBlock Text="頁面範圍" FontSize="15" FontWeight="SemiBold"/>
                      <RadioButton x:Name="WordAll" Content="全部頁面" Foreground="{StaticResource InkBrush}" GroupName="WordPages" Margin="0,14,0,0" Checked="OnWordOptionChanged"/>
                      <RadioButton x:Name="WordCurrent" Content="目前頁" Foreground="{StaticResource InkBrush}" GroupName="WordPages" Margin="0,10,0,0" Checked="OnWordOptionChanged"/>
                      <RadioButton x:Name="WordRange" Content="指定範圍" Foreground="{StaticResource InkBrush}" GroupName="WordPages" Margin="0,10,0,0" Checked="OnWordOptionChanged"/>
                      <TextBox x:Name="WordRangeBox" Style="{StaticResource FieldBox}" Margin="22,8,0,0" IsEnabled="False" ToolTip="例：1-3, 5, 8-"/>
                      <TextBlock x:Name="WordRangeHint" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" Margin="22,6,0,0" TextWrapping="Wrap"/>
                      <CheckBox x:Name="WordUseEdits" Content="套用「編輯 PDF」中已修改的文字" Margin="0,22,0,0"/>
                      <Button x:Name="WordButton" Content="轉成 Word  →" Style="{StaticResource PrimaryButton}" Click="OnWordConvert" Margin="0,26,0,0" IsEnabled="False"/>
                  </StackPanel>
              </Border>
          </Grid>
        </Grid>

        <!-- ===== status ===== -->
        <Border Grid.Row="2" Background="#0F1724" BorderBrush="#1E2B40" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="啟動中…" Foreground="#AEBCCD" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1" Visibility="Hidden" VerticalAlignment="Center"/>
                <Button x:Name="SharkToggle" Grid.Column="2" Content="🦈  恢復一般游標" Style="{StaticResource GhostButton}" Click="OnSharkToggle"
                        Padding="10,2" Margin="14,-2,-6,-2" FontSize="11" Foreground="#66E5FF" ToolTip="按下後恢復成正常滑鼠游標"/>
            </Grid>
        </Border>

        <!-- signature cursor: last child, spans every row -->
        <c:DotMatrixSharkCursor x:Name="SharkCursor" Grid.Row="0" Grid.RowSpan="3"
                                Label="LouisTool" Kind="hammerhead" Length="220"/>
    </Grid>
</Window>
