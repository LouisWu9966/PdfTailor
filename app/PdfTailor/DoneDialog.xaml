<Window x:Class="PdfTailor.DoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="輸出完成" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="#0F1724" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="26,22">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Badge" Width="34" Height="34" CornerRadius="17" Background="#65E6AD">
                <TextBlock x:Name="BadgeText" Text="✓" FontSize="18" FontWeight="Bold" Foreground="#05140D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="Heading" Text="輸出完成" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Detail" Foreground="#C6D4EA" FontSize="13" Margin="0,14,0,6" TextWrapping="Wrap"/>
        <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" IsReadOnly="True" FontSize="12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="開啟資料夾" Style="{StaticResource GhostButton}" Click="OnOpenFolder" Padding="16,9"/>
            <Button Content="開啟檔案" Style="{StaticResource GhostButton}" Click="OnOpenFile" Padding="16,9" Margin="10,0,0,0"/>
            <Button Content="完成" Style="{StaticResource PrimaryButton}" Click="OnClose" Margin="10,0,0,0" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
